    "express-session": "^1.19.0",
    "graphql-request": "^7.0.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "memjs": "^1.3.1",
    "method-override": "^3.0.0",
    "moment": "^2.30.1",
    "morgan": "^1.11.0",
    "node-fetch": "^3.3.2",
    "node-sass-middleware": "^1.1.0",
    "pg": "^8.23.0",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.29.7",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.4.1",
    "eslint": "^10.9.1",
